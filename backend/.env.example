# Get this from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get this from https://elevenlabs.io/ (or another TTS provider)
TTS_API_KEY=your_elevenlabs_api_key_here

# Get this from your Supabase Project Settings -> API
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# Google Calendar OAuth (Phase 1)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# GitHub OAuth (Phase 2)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
